{
  "name": "@soloops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SoloOps API: Hono on Node.js, all business logic and MongoDB access (ADR-0010, ADR-0012).",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@node-rs/argon2": "2.2.2",
    "@soloops/contracts": "0.0.0",
    "hono": "4.13.13",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "esbuild": "0.28.2"
  }
}
