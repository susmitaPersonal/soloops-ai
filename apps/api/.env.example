# Copy to apps/api/.env and fill in. Never commit real values (SEC-007).
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=soloops
# >= 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
LOG_LEVEL=info
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
TRUST_PROXY=false

# AI (optional, FR-050). Off by default. `mock` is for tests only and is refused in production.
# For an OpenAI-compatible endpoint serving an open-weight model (vLLM, llama.cpp server,
# Ollama compatibility mode, a hosted provider), set:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://your-endpoint.example.com/v1
#   AI_MODEL=your-model-name
#   AI_API_KEY=            # secret; leave empty if the endpoint needs none
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_STRUCTURED_OUTPUT=prompt
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1500
AI_STORE_PROMPTS=false
AI_GENERATION_RETENTION_DAYS=365
RATE_LIMIT_AI_PER_HOUR=20
